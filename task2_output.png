            event_status = <span class="hljs-string">"Successful login"</span>
            is_success = <span class="hljs-literal">True</span>
        <span class="hljs-keyword">else</span>:
            event_status = <span class="hljs-string">"Failed login"</span>
            is_success = <span class="hljs-literal">False</span>

        print(<span class="hljs-string">f"Event ID: <span class="hljs-subst">{event_id}</span>"</span>)
        print(<span class="hljs-string">f"Username: <span class="hljs-subst">{username}</span>"</span>)
        print(<span class="hljs-string">f"IP Address: <span class="hljs-subst">{ip_address}</span>"</span>)
        print(<span class="hljs-string">f"Event: <span class="hljs-subst">{event_status}</span>"</span>)
        print(<span class="hljs-string">f"Timestamp: <span class="hljs-subst">{timestamp}</span>\n"</span>)
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><h3 dir="ltr" data-path-to-node="6">Next Steps for Task 2:</h3><ol start="1" dir="ltr" data-path-to-node="7"><li><p dir="ltr" data-path-to-node="7,0,0"><span>Create your new file named </span><b data-path-to-node="7,0,0" data-index-in-node="27"><code data-path-to-node="7,0,0" data-index-in-node="27">security_event_logger.py</code></b><span> in VS Code on your </span><code data-path-to-node="7,0,0" data-index-in-node="71">security-event-logger</code><span> branch.</span></p></li><li><p dir="ltr" data-path-to-node="7,1,0"><span>Paste your code into it and save (</span><code data-path-to-node="7,1,0" data-index-in-node="34">Ctrl + S</code><span>).</span></p></li><li><p dir="ltr" data-path-to-node="7,2,0"><span>Test it in your terminal (</span><code data-path-to-node="7,2,0" data-index-in-node="26">py security_event_logger.py</code><span>) to verify the logs print out correctly.</span></p></li><li><p dir="ltr" data-path-to-node="7,3,0"><span>Stage,</span><span> commit,</span><span> and push it to GitHub on your </span><code data-path-to-node="7,3,0" data-index-in-node="45">security-event-logger</code><span> branch!</span></p></li></ol></div><!----></message-content><!----><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><!----><!----><!